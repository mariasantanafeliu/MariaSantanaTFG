<launch>
    <arg name="prefix_auto" default="auto"/>
    <arg name="kp" default="1.0"/>
    <arg name="ki" default="0.0"/>
    <arg name="kd" default=""/>
    <arg name="kf" default="0.02"/>
    <arg name="p_estimado" default="0.24"/>
    <arg name="tool_length" default="0.3415"/>
    <arg name="type" default="1"/>
    <arg name="sensor_ip" default="192.168.1.1"/>
    <arg name="base" default="218.27"/> <!-- 45 -->
    <arg name="shoulder" default="-137.54"/> <!-- -90 -->
    <arg name="elbow" default="-20.97"/><!-- -90 -->
    <arg name="wrist1" default="-111.5"/><!-- -90 -->
    <arg name="wrist2" default="90.43"/><!-- 90 -->
    <arg name="wrist3" default="0"/> <!--LO QUE SEA A BASE +-90-->
    <!-- mock fuerza -->
    <node name="fulcrum_force_Moch" pkg="uma_fp_control" type="fulcrumSensor" output="screen">
        <param name="prefix" value="$(arg prefix_auto)" type="str"/>
        <param name="p_estimado" value="$(arg p_estimado)" type="double"/>
    </node> 
    <!-- Lanzar el nodo coordinator -->
    <param name="prefix" value="$(arg prefix_auto)" type="str"/>
    <node pkg="uma_fp_control" type="coordinatorONE" name="coordinator" output="screen"/>
    <!-- Lanzar el nodo control -->
    <group ns="$(arg prefix_auto)">
        <remap from="/ur_hardware_interface/script_command" to="/$(arg prefix_auto)/ur_hardware_interface/script_command" />
        <node name="MyJacobianControl" pkg="uma_fp_control" type="jacobianControl" output="screen"> <!-- <node name="MyControlForce" pkg="uma_fp_control" type="jacobianControl forceControl" output="screen"> -->
            <param name="prefix" value="$(arg prefix_auto)" type="str"/>
            <param name="kp" value="$(arg kp)"  type="double"/>
            <param name="ki" value="$(arg ki)" type="double"/>
            <param name="kd" value="0" type="double"/>
            <param name="kf" value="$(arg kf)" type="double"/>
            <param name="p_estimado" value="$(arg p_estimado)" type="double"/>
            <param name="tool_length" value="$(arg tool_length)" type="double"/>
            <param name="type" value="$(arg type)" type="int"/>
            <param name="sensor_ip" value="$(arg sensor_ip)" type="str"/>
            <param name="base" value="$(arg base)"  type="double"/>
            <param name="shoulder" value="$(arg shoulder)"  type="double"/>
            <param name="elbow" value="$(arg elbow)"  type="double"/>
            <param name="wrist1" value="$(arg wrist1)"  type="double"/>
            <param name="wrist2" value="$(arg wrist2)"  type="double"/>
            <param name="wrist3" value="$(arg wrist3)"  type="double"/>
        </node>
    </group>
</launch>
